# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SnapTrade Personal API key (server-only; never prefix with NEXT_PUBLIC_)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Only this email may view SnapTrade data (a Personal key represents one person)
OWNER_EMAIL=

# Stock screener: Financial Modeling Prep free key (server-only)
FMP_API_KEY=
# Server-only; lets the screener sync write the shared fundamentals cache. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
